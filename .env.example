# Copie para .env e preencha. Nunca suba o .env para o GitHub.
# ATENÇÃO: variável vazia substitui o padrão do nuxt.config. Para usar o padrão, deixe a linha comentada.

# ===== Site =====
NUXT_PUBLIC_SITE_URL=https://usesempregabriela.com.br

# ===== Melhor Envio (PAC e SEDEX) =====
# Sem token o frete é uma ESTIMATIVA, e em produção a loja não aceita pedidos.
NUXT_MELHOR_ENVIO_TOKEN=
# O Melhor Envio exige nome do app + e-mail de contato técnico:
# NUXT_MELHOR_ENVIO_USER_AGENT="Nome do app (email-tecnico@dominio)"
# NUXT_MELHOR_ENVIO_API_URL=https://sandbox.melhorenvio.com.br
# NUXT_MELHOR_ENVIO_CEP_ORIGEM=95680276

# ===== Mercado Pago — https://www.mercadopago.com.br/developers/panel/app =====
# Sem essas variáveis: demonstração no `npm run dev`, e em produção a loja não aceita pedidos.
NUXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
NUXT_MERCADO_PAGO_ACCESS_TOKEN=
NUXT_MERCADO_PAGO_WEBHOOK_SECRET=
